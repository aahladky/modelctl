{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "isolatedModules": true,
    // So a lib module a test loads directly can name its imports the way
    // node resolves them: `node --test` runs these files raw, with no
    // bundler to guess an extension, so an extensionless RUNTIME import
    // inside a tested module fails at resolve time. Legal under noEmit,
    // and vite resolves an explicit .ts either way.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "//": "Test files are run by `node --test`, not built by vite, and they import node: builtins that would need @types/node vendored. Zero new dependencies was the deliberate choice for the console's test story, so they sit outside the build's type gate -- running them is what checks them.",
  "exclude": ["src/**/*.test.ts"]
}
